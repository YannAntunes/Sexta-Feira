# ===================================================================
# SEXTA-FEIRA — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com valores reais locais.
# NUNCA faça commit do arquivo .env com credenciais reais.
# ===================================================================

# Banco de Dados MySQL
DB_URL=jdbc:mysql://localhost:3306/sexta_feira_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me_mysql_password

# Configurações JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Serviço Python (sexta-feira-ia)
SEXTA_IA_URL=http://127.0.0.1:8000

# Integrações Financeiras
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_TOKEN=change_me_brapi_token
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Integração WhatsApp e Segurança do Webhook
WHATSAPP_API_URL=https://seu-provedor-whatsapp.exemplo.com/messages
WHATSAPP_API_TOKEN=change_me_whatsapp_api_token
WHATSAPP_WEBHOOK_SECRET=change_me_webhook_hmac_or_secret

# Monitoramento Automático de Orçamentos
MONITORAMENTO_ENABLED=true
MONITORAMENTO_WHATSAPP_TO=5500000000000
MONITORAMENTO_DELAY_MS=600000

# Contexto de Autenticação REST
SEXTA_DEFAULT_WHATSAPP=local-dev-user
SEXTA_AUTH_REQUIRE_HEADER=false

# Inteligência Artificial e Modelos de Linguagem (sexta-feira-ia)
# Padrão: LLM desativada (usa regras determinísticas locais sem custo e sem chave externa)
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3.5
